<Window x:Class="TtsOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS Overlay Settings" Height="860" Width="440" MinHeight="400"
        Icon="logo.png"
        WindowStartupLocation="CenterScreen">
    <!-- 본문은 스크롤, 미리듣기/저장 버튼은 아래에 고정 -->
    <DockPanel Margin="15">
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PreviewButton" Content="▶ 미리듣기" Width="100" Height="30" Click="PreviewButton_Click"/>
            <Button x:Name="SaveButton" Content="저장 및 닫기" Grid.Column="2" Width="120" Height="30" Click="SaveButton_Click"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TTS 서버 API URL:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="ApiUrlTextBox" Grid.Row="1" Margin="0,0,0,15" Padding="2"/>

        <TextBlock Text="음성 출력 장치 선택 (예: VB-Cable):" Grid.Row="2" FontWeight="Bold" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <ComboBox x:Name="DeviceComboBox" Padding="2"/>
            <CheckBox x:Name="MonitorOnSendCheckBox" Content="송출시 듣기" Margin="0,8,0,4"
                      ToolTip="체크하면 위 장치로 송출하는 소리를 아래 듣기 장치로도 동시에 들려줍니다."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="듣기 장치:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="MonitorDeviceComboBox" Grid.Column="1" Padding="2"
                          ToolTip="내가 듣는 스피커/헤드셋. 미리듣기도 이 장치로 재생됩니다."/>
            </Grid>
        </StackPanel>

        <TextBlock Text="목소리 오디오 파일 (.wav, .flac, .ogg, .opus, .mp3, .m4a):" Grid.Row="4" FontWeight="Bold" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SpeakerIdTextBox" Padding="2" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseSpeakerButton" Grid.Column="1" Content="찾아보기" Width="80" Margin="5,0,0,0" Click="BrowseSpeakerButton_Click"/>
            </Grid>
            <TextBlock Text="⏱ 참조 구간 지정 (15초 초과 파일만 · 비우면 앞 15초 자동 · 최소 3초):" FontSize="11" Foreground="#777" Margin="0,6,0,3"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="시작" VerticalAlignment="Center"/>
                <TextBox x:Name="RefStartTextBox" Width="55" Margin="4,0,4,0" Padding="2" VerticalContentAlignment="Center"/>
                <TextBlock Text="초  ~  끝" VerticalAlignment="Center"/>
                <TextBox x:Name="RefEndTextBox" Width="55" Margin="4,0,4,0" Padding="2" VerticalContentAlignment="Center"/>
                <TextBlock Text="초" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,15">
            <TextBlock Text="전역 단축키 (오버레이 열기/닫기):" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HotkeyTextBox" IsReadOnly="True" Padding="2" VerticalContentAlignment="Center"
                         Cursor="Hand" TextAlignment="Center" FontWeight="Bold"
                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                         GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus"/>
                <Button x:Name="ResetHotkeyButton" Grid.Column="1" Content="기본값" Width="70" Margin="5,0,0,0"
                        Click="ResetHotkeyButton_Click" ToolTip="Ctrl + T 로 되돌리기"/>
            </Grid>

            <TextBlock Text="재생 중단 단축키 (나오고 있는 소리 즉시 끊기):" FontWeight="Bold" Margin="0,10,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StopHotkeyTextBox" IsReadOnly="True" Padding="2" VerticalContentAlignment="Center"
                         Cursor="Hand" TextAlignment="Center" FontWeight="Bold"
                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                         GotFocus="HotkeyTextBox_GotFocus" LostFocus="HotkeyTextBox_LostFocus"/>
                <Button x:Name="ResetStopHotkeyButton" Grid.Column="1" Content="기본값" Width="70" Margin="5,0,0,0"
                        Click="ResetStopHotkeyButton_Click" ToolTip="Ctrl + Alt + X 로 되돌리기"/>
            </Grid>
            <TextBlock Text="칸을 클릭한 뒤 원하는 조합을 누르세요 (예: Ctrl+Shift+T). 수정자(Ctrl/Alt/Shift/Win) 1개 이상 필수."
                       FontSize="11" Foreground="#777" TextWrapping="Wrap" Margin="0,4,0,10"/>

            <CheckBox x:Name="SpotlightModeCheckBox" Content="작고 심플한 텍스트 전용 창 모드 사용 (체크 시 크기 축소)"
                      ToolTip="심플 창에서는 버튼이 숨겨집니다. 입력창을 우클릭하면 설정·일반 창 전환·종료 메뉴가 나옵니다."/>
            <TextBlock Text="심플 창에서 되돌리기: 입력창 우클릭 → 일반 창으로 전환"
                       FontSize="11" Foreground="#777" Margin="20,2,0,0"/>
        </StackPanel>

        <TextBlock x:Name="VolumeLabel" Text="음성 출력 볼륨 조절: 100%" Grid.Row="7" FontWeight="Bold" Margin="0,0,0,5"/>
        <Slider x:Name="VolumeSlider" Grid.Row="8" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,15"/>

        <Border Grid.Row="9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🎚 목소리 복제 튜닝 (숫자가 낮을수록 원본 목소리에 가까움)" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock x:Name="AlphaLabel" Text="음색 유사도 (alpha): 0.10" Margin="0,0,0,2"/>
                <Slider x:Name="AlphaSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                <TextBlock x:Name="BetaLabel" Text="억양 유사도 (beta): 0.50" Margin="0,0,0,2"/>
                <Slider x:Name="BetaSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                <TextBlock x:Name="StepsLabel" Text="품질/노이즈 제거 (diffusion steps): 10" Margin="0,0,0,2"/>
                <Slider x:Name="StepsSlider" Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                <TextBlock x:Name="SpeedLabel" Text="말하는 속도 (speed): 1.0배" Margin="0,0,0,2"/>
                <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </Border>

    </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>

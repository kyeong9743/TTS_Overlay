<Window x:Class="TtsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS Overlay" Height="150" Width="600"
        Icon="logo.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    
    <Border x:Name="MainBorder" Background="#2C2C2C" CornerRadius="10" Padding="15" BorderBrush="#555" BorderThickness="1" MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <!-- 우클릭 메뉴. 심플 창 모드에서는 윗줄 버튼이 숨겨지므로, 창 전환과 종료는 이 메뉴로만 할 수 있음 -->
        <Border.ContextMenu>
            <ContextMenu x:Name="OverlayMenu">
                <MenuItem Header="설정" Click="SettingsButton_Click"/>
                <MenuItem x:Name="ToggleModeMenuItem" Header="심플 창으로 전환" Click="ToggleModeMenuItem_Click"/>
                <MenuItem Header="현재 위치 저장" Click="SaveLocationButton_Click"/>
                <Separator/>
                <MenuItem Header="종료" Click="CloseButton_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid x:Name="HeaderGrid" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="logo.png" Width="18" Height="18" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="TTS Overlay" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="💾" Width="25" Height="25" Background="Transparent" Foreground="White" BorderThickness="0" Click="SaveLocationButton_Click" ToolTip="현재 위치 저장"/>
                    <Button Content="⚙" Width="25" Height="25" Background="Transparent" Foreground="White" BorderThickness="0" Click="SettingsButton_Click" ToolTip="Settings"/>
                    <Button Content="X" Width="25" Height="25" Background="Transparent" Foreground="White" BorderThickness="0" Click="CloseButton_Click" ToolTip="완전 종료"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputTextBox" FontSize="18" Padding="5" 
                         TextWrapping="Wrap" AcceptsReturn="True" 
                         Background="#1E1E1E" Foreground="White" BorderThickness="0"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown" />

                <!-- 심플 창 모드 전용 설정 버튼. 윗줄 버튼이 숨겨져도 설정으로 갈 수 있게 함 -->
                <Button x:Name="SimpleSettingsButton" Grid.Column="1" Content="⚙" Width="34" Height="34" FontSize="18"
                        Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="Transparent" Foreground="White" BorderThickness="0" Focusable="False"
                        Click="SettingsButton_Click" ToolTip="설정 (우클릭: 일반 창 전환·종료 메뉴)"/>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready. Press Enter to send, Esc to hide." Foreground="#888" Margin="0,5,0,0" FontSize="11" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
